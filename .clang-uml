compilation_database_dir: build
output_directory: gstpipestudio/docs/uml

diagrams:
  architecture_overview:
    type: package
    package_type: directory
    glob:
      - gstpipestudio/Pipeline/**/*.cpp
      - gstpipestudio/GstEngine/**/*.cpp
      - gstpipestudio/GUI/**/*.cpp

  core_overview:
    type: class
    title: "GstPipeStudio Core — High Level Overview (Relationships Only)"
    glob:
      - gstpipestudio/Pipeline/**/*.cpp
      - gstpipestudio/GstEngine/**/*.cpp
      - gstpipestudio/Pipeline/**/*.h
      - gstpipestudio/GstEngine/**/*.h
    include:
      namespaces:
        - gps
    exclude:
      access:
        - public
        - protected
        - private
    include_relations_also_as_members: false
    generate_packages: true

  app_overview:
    type: class
    title: "GstPipeStudio App — High Level Overview (Relationships Only)"
    glob:
      - gstpipestudio/GUI/**/*.cpp
      - gstpipestudio/GUI/**/*.h
    exclude:
      access:
        - public
        - protected
        - private
    include_relations_also_as_members: false
    generate_packages: true

  core_detailed:
    type: class
    title: "GstPipeStudio Core — Zoom-In Details (Public & Protected Members)"
    glob:
      - gstpipestudio/Pipeline/**/*.cpp
      - gstpipestudio/GstEngine/**/*.cpp
      - gstpipestudio/Pipeline/**/*.h
      - gstpipestudio/GstEngine/**/*.h
    include:
      namespaces:
        - gps
    exclude:
      access:
        - private
    generate_packages: true

  app_detailed:
    type: class
    title: "GstPipeStudio App — Zoom-In Details (Public & Protected Members)"
    glob:
      - gstpipestudio/GUI/**/*.cpp
      - gstpipestudio/GUI/**/*.h
    exclude:
      access:
        - private
    generate_packages: true
