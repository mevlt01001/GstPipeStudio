compilation_database_dir: build
output_directory: docs/uml
diagrams:
  core_class_diagram:
    type: class
    glob:
      - gstpipestudio/core/**/*.cpp
      - gstpipestudio/core/**/*.h
    include:
      namespaces:
        - gps
    generate_packages: true
  app_class_diagram:
    type: class
    glob:
      - gstpipestudio/app/**/*.cpp
      - gstpipestudio/app/**/*.h
    generate_packages: true

