# GstPipeStudio Runnable Application Container
# Ubuntu 22.04 + GstPipeStudio + GStreamer Plugins
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

ARG DEB_FILE=out/GstPipeStudio-22.04-x86_64.deb
COPY ${DEB_FILE} /tmp/gstpipestudio.deb

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        /tmp/gstpipestudio.deb \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav \
        gstreamer1.0-tools \
        gstreamer1.0-x \
        gstreamer1.0-gl \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/* /tmp/gstpipestudio.deb

ENTRYPOINT ["gstpipestudio"]

